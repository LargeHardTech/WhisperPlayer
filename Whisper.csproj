<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Copyright>LargeHardTech</Copyright>
    <Company>LargeHardTech</Company>
    <Authors>LargeHardTech</Authors>
    <ApplicationIcon>assets\Whisper_Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

  <!-- libonigwrap.dll 已嵌入 exe，发布时删除外部副本（AOT 在 ComputeFilesToPublish 之后复制 native 资产） -->
  <Target Name="RemoveEmbeddedNatives" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libonigwrap.dll;$(PublishDir)bass_aac.dll" />
  </Target>

  <!-- bass.dll + bass_fx.dll + bass_aac.dll + ffmpeg.exe + libonigwrap.dll → 编译时嵌入，运行时自解压 -->
  <ItemGroup>
    <EmbeddedResource Include="bass.dll" />
    <EmbeddedResource Include="bass_fx.dll" />
    <EmbeddedResource Include="bass_aac.dll" />
    <EmbeddedResource Include="ffmpeg.exe.br" />
    <EmbeddedResource Include="$(NuGetPackageRoot)onigwrap/1.0.11/runtimes/win-x64/native/libonigwrap.dll" Link="libonigwrap.dll" />
  </ItemGroup>

</Project>
